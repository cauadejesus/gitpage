doctype html
html(lang='en')
doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Contatos

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page content
            section.py-5

                .container.px-5

                    // Contact form
                    .bg-light.rounded-4.py-5.px-4.px-md-5
                        .text-center.mb-5
                            .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.mb-3
                                i.bi.bi-envelope
                            h1.fw-bolder Entre em contato
                            p.lead.fw-normal.text-muted.mb-0 Vamos trabalhar juntos!
                        .row.gx-5.justify-content-center
                            .col-lg-8.col-xl-6

                                form#contactForm(data-sb-form-api-token='API_TOKEN')

                                    .form-floating.mb-3
                                        input#name.form-control(type='text', placeholder='Digite seu nome...', data-sb-validations='required')
                                        label(for='name') Nome completo
                                        .invalid-feedback(data-sb-feedback='name:required') Um nome é obrigatório.

                                    .form-floating.mb-3
                                        input#email.form-control(type='email', placeholder='nome@exemplo.com', data-sb-validations='required,email')
                                        label(for='email') E-mail
                                        .invalid-feedback(data-sb-feedback='email:required') Um e-mail é obrigatório.
                                        .invalid-feedback(data-sb-feedback='email:email') E-mail não é válido.

                                    .form-floating.mb-3
                                        input#phone.form-control(type='tel', placeholder='(12) 34567-8901', data-sb-validations='required')
                                        label(for='phone') Telefone
                                        .invalid-feedback(data-sb-feedback='phone:required') Um telefone é obrigatório.

                                    .form-floating.mb-3
                                        textarea#message.form-control(type='text', placeholder='Digite sua mensagem aqui...', style='height: 10rem;', data-sb-validations='required')
                                        label(for='message') Mensagem
                                        .invalid-feedback(data-sb-feedback='message:required') Uma mensagem é obrigatória.

                                    #submitSuccessMessage.d-none
                                        .text-center.mb-3
                                            .fw-bolder Form submission successful!
                                            | To activate this form, sign up at
                                            br
                                            a(href='https://startbootstrap.com/solution/contact-forms') https://startbootstrap.com/solution/contact-forms

                                    #submitErrorMessage.d-none
                                        .text-center.text-danger.mb-3 Erro ao enviar a mensagem!

                                    .d-grid
                                        button#submitButton.btn.btn-primary.btn-lg.disabled(type='submit') Enviar

        // Footer
        include includes/footer.pug

        include includes/scripts.pug

        script(src='https://cdn.startbootstrap.com/sb-forms-latest.js')
                                            | A phone number is required.
