doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Resumo

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100.bg-light

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Page Content
            .container.px-5.my-5
                .text-center.mb-5
                    h1.display-5.fw-bolder.mb-0
                        span.text-gradient.d-inline Resumo
                .row.gx-5.justify-content-center

                    .col-lg-11.col-xl-9.col-xxl-8

                        // Experience Section
                        section
                            .d-flex.align-items-center.justify-content-between.mb-4
                                h2.text-primary.fw-bolder.mb-0 Experiência
                            
                            // Experience Card 1
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-primary.fw-bolder.mb-2 2026 - Presente
                                                .small.fw-bolder Web Developer
                                                .small.text-muted UniCEUB
                                                .small.text-muted Distrito Federal, DF
                                        .col-lg-8
                                            div Desenvolvi um site web sobre meu portfólio na matéria de BootCamp 1.

                            // Experience Card 2
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-primary.fw-bolder.mb-2 2026 - Presente
                                                .small.fw-bolder Ciêntista de Dados
                                                .small.text-muted Monitoria do UniCEUB
                                                .small.text-muted Distrito Federal, DF
                                        .col-lg-8
                                            div Apliquei conhecimentos em análise de dados e machine learning para resolver problemas em projetos acadêmicos.

                        // Education Section
                        section
                            h2.text-secondary.fw-bolder.mb-4 Educação
                            
                            // Education Card 1
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-secondary.fw-bolder.mb-2 2014 - 2025
                                                .mb-2
                                                    .small.fw-bolder Colégio Adventista de Planaltina
                                                    .small.text-muted Planaltina, DF
                                                .fst-italic
                                                    .small.text-muted Formando
                                                    .small.text-muted Ensino Fundamental e Médio
                                        .col-lg-8
                                            div Aprendi a trabalhar em grupo e a utilizar diferentes tecnologias e ferramentas de programação.

                            // Education Card 2
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-secondary.fw-bolder.mb-2 2026 - 2029
                                                .mb-2
                                                    .small.fw-bolder UniCEUB
                                                    .small.text-muted Brasília, DF
                                                .fst-italic
                                                    .small.text-muted Graduado
                                                    .small.text-muted Ciência da Computação
                                        .col-lg-8
                                            div Aprendi conceitos de programação e resolvi problemas em equipes multidisciplinares.

                        // Divider
                        .pb-5

                        // Skills Section
                        section
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .mb-5
                                        .d-flex.align-items-center.mb-4
                                            .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                                                i.bi.bi-tools
                                            h3.fw-bolder.mb-0
                                                span.text-gradient.d-inline Skills Professionais
                                        .row.row-cols-1.row-cols-md-3.mb-4
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Web Development
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Data Scientist
                                            .col
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Marketing
                                        .row.row-cols-1.row-cols-md-3
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 User Interface Design
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Microsoft Software's
                                            .col
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Google Software's
                                    .mb-0
                                        .d-flex.align-items-center.mb-4
                                            .feature.bg-primary.bg-gradient-primary-to-secondary.text-white.rounded-3.me-3
                                                i.bi.bi-code-slash
                                            h3.fw-bolder.mb-0
                                                span.text-gradient.d-inline Linguagens/marcação
                                        .row.row-cols-1.row-cols-md-3.mb-4
                                            .col
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 Python
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 C
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 CSS
                                        .row.row-cols-1.row-cols-md-3
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100 HTML
                                            .col.mb-4.mb-md-0
                                                .d-flex.align-items-center.bg-light.rounded-4.p-3.h-100
                                                    | Git
                                                    br
                                                    | e GitHub

                        section
                            .d-flex.align-items-center.justify-content-between.mb-4
                                h2.text-primary.fw-bolder.mb-0 Links úteis
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-primary.fw-bolder.mb-2
                                                    a(href='assets/curriculum.pdf', target='_blank', style='color: #000000; text-decoration: underline;') CURRÍCULO
                                        .col-lg-8
                                            div PDF onde se encontra meu currículo detalhado.
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-primary.fw-bolder.mb-2
                                                    a(href='assets/PortfólioHub.pdf', target='_blank', style='color: #000000; text-decoration: underline;') APRESENTAÇÃO
                                        .col-lg-8
                                            div Uma apresentação sobre minhas experiências e hobbies.
                            .card.shadow.border-0.rounded-4.mb-5
                                .card-body.p-5
                                    .row.align-items-center.gx-5
                                        .col.text-center.text-lg-start.mb-4.mb-lg-0
                                            .bg-light.p-4.rounded-4
                                                .text-primary.fw-bolder.mb-2
                                                    a(href='https://sites.google.com/view/portifoliohub-caua-aguiar/page', target='_blank', style='color: #000000; text-decoration: underline;') SITE
                                        .col-lg-8
                                            div Um site criado com o intuito de apresentar meu portfólio e projetos.

        // Footer
        include includes/footer.pug

        include includes/scripts.pug