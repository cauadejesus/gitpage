doctype html
html(lang='en')

    head

        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='')
        meta(name='author', content='')

        title Projetos

        // Favicon
        link(rel='icon', type='image/x-icon', href='assets/favicon.ico')

        include includes/css.pug

    body.d-flex.flex-column.h-100.bg-light

        main.flex-shrink-0

            // Navigation
            include includes/navbar.pug

            // Projects Section
            section.py-5
                .container.px-5.mb-5
                    .text-center.mb-5
                        h1.display-5.fw-bolder.mb-0
                            span.text-gradient.d-inline Projetos
                    .row.gx-5.justify-content-center

                        .col-lg-11.col-xl-9.col-xxl-8

                            // Project Card 1
                            .card.overflow-hidden.shadow.rounded-4.border-0.mb-5
                                .card-body.p-0
                                    .d-flex.align-items-center
                                        .p-5
                                            h2.fw-bolder Projeto Fakeflix
                                            p Um projeto de streaming fictício para praticar desenvolvimento web proposto em um curso feito pela Alura.
                                        a(href='https://cauadejesus.github.io/FakeFlix/catalogo/catalogo.html', target='_blank', rel='noopener noreferrer')
                                            img.img-fluid(src='assets/fakeflix.png', alt='Fakeflix')

                            // Project Card 2
                            .card.overflow-hidden.shadow.rounded-4.border-0
                                .card-body.p-0
                                    .d-flex.align-items-center
                                        .p-5
                                            h2.fw-bolder Projeto Site-Adroid
                                            p Site criado com o intuito de contar curiosidades sobre a história do Android.
                                        a(href='https://cauadejesus.github.io/html-css/desafios/d010/android.html', target='_blank', rel='noopener noreferrer')
                                            img.img-fluid(src='assets/android_site.png', alt='Android Site')

            // Call to action section
            section.py-5.bg-gradient-primary-to-secondary.text-white
                .container.px-5.my-5
                    .text-center
                        h2.display-4.fw-bolder.mb-4 Vamos criar algo juntos
                        a.btn.btn-outline-light.btn-lg.px-5.py-3.fs-6.fw-bolder(href='contact.html') ME CONTATE

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
                        h2.display-4.fw-bolder.mb-4 Let's build something together
                        a.btn.btn-outline-light.btn-lg.px-5.py-3.fs-6.fw-bolder(href='contact.html') Contact me

        // Footer
        include includes/footer.pug

        include includes/scripts.pug
